@inproceedings{Viamontes2004_HighPerformanceQuIDDBasedSimulationOfQuantumCircuits,
  author    = {Viamontes, George F. and Markov, Igor L. and Hayes, John P.},
  title     = {High-Performance QuIDD-Based Simulation of Quantum Circuits},
  booktitle = {Proceedings of the Conference on Design, Automation and Test in Europe - Volume 2},
  series    = {DATE '04},
  pages     = {21354},
  year      = {2004},
  publisher = {IEEE Computer Society},
  address   = {USA},
  isbn      = {0769520855},
  abstract  = {Simulating quantum computation on a classical computer is a difficult problem. The matrices representing quantum gates, and vectors modeling qubit states grow exponentially with the number of qubits. It has been shown experimentally that the QuIDD (Quantum Information Decision Diagram) datastructure greatly facilitates simulations using memory and runtime that are polynomial in the number of qubits. In this paper, we present a complexity analysis which formally describes this class of matrices and vectors. We also present an improved implementation of QuIDDs which can simulate Grover's algorithm for quantum search with the asymptotic runtime complexity of an ideal quantum computer up to negligible overhead.},
}

