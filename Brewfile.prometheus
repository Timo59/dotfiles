# Brewfile.prometheus — MacBook (prometheus) specific packages
# =============================================================================
# Packages installed only on the MacBook Pro (hostname: prometheus).
# Shared packages belong in the root Brewfile.
# Add entries here as the machines diverge over time.
# =============================================================================

# Mesh VPN — reaches the home LAN (and Paperbase on the Pi) from anywhere.
# The formula, not the cask: the daemon and CLI without the menu-bar app.
# Configured by tailscale.prometheus.sh. Not needed on lucifer, which never
# leaves the LAN.
brew 'tailscale'

# Example:
# brew "some-work-tool"
# cask "faculty-vpn-client"
